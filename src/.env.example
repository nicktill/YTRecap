# AI providers: OpenAI is tried first, then Gemini as a backup. With neither set, the app runs in demo mode (sample summary).

# Free: a Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Or paid: an OpenAI key (billed per use at platform.openai.com)
# OPENAI_KEY=

# Set both to fall back to OpenAI when Gemini is out of quota or down.
# Optional: override the models (defaults: gemini-flash-latest / gpt-4o-mini)
# GEMINI_MODEL=
# OPENAI_MODEL=

# Optional: adds views, publish date and duration to the video card.
# Without it, title and channel come from YouTube's keyless oEmbed.
# YT_KEY=

# Optional residential proxy for caption requests. Set in Vercel Preview and Production.
# Use the provider-supplied authenticated HTTP(S) proxy URL; never commit its value.
YT_PROXY_URL=
