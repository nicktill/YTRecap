# Pick ONE AI provider. With neither set, the app runs in demo mode (sample summary).

# Free: a Gemini API key from https://aistudio.google.com/apikey
# Also lets Gemini watch the video when YouTube blocks transcript fetches (common on cloud hosts).
GEMINI_API_KEY=

# Or paid: an OpenAI key (billed per use at platform.openai.com)
# OPENAI_KEY=

# Optional: override the model (defaults: gemini-flash-latest / gpt-4o-mini)
# AI_MODEL=

# Optional: adds views, publish date and duration to the video card.
# Without it, title and channel come from YouTube's keyless oEmbed.
# YT_KEY=
