# Required for real summaries. Without it the app runs in demo mode.
OPENAI_KEY=
# Optional: defaults to gpt-4o-mini. Any chat-completions model works.
# OPENAI_MODEL=gpt-4o-mini
# Optional: point at any OpenAI-compatible API (e.g. Gemini's free tier):
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Optional: adds views/date/duration. Without it, title + channel come from oEmbed.
YT_KEY=
